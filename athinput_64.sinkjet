<job>
  problem_id = jet
</job>

<mesh>
  mesh_type = cartesian
  nx1 = 64
  nx2 = 64
  nx3 = 64
  x1min = -0.5
  x1max =  0.5
  x2min = -0.5
  x2max =  0.5
  x3min = -0.5
  x3max =  0.5

  ix1_bc = User
  ox1_bc = User
  ix2_bc = User
  ox2_bc = User
  ix3_bc = User
  ox3_bc = User
</mesh>
  
<time>
  tlim = 1.4
  nlim = -1
  cfl_number = 0.3 #for 3D must be < 0.3
</time>
<hydro>
  iso_sound_speed = 1
</hydro>
  
<problem>
  rho0 = 1  
  sink_x0 = 0.0
  sink_y0 = 0.0
  sink_z0 = 0.0
  r_sink = 0.03125
  rho_thr = 4
  rho_floor = 1e-6
  Msink0 = 0.02
  g_soft = 0.03125
  Gconst = 3.14159265358979323846
  jet_switch = 1
  lock_pdot = 1   
  
  Pdot = 0.01
  r_noz   = 0.01875 #cone:0.0324759526
  L_noz   = 0.075 
  v_jet   = 3.0
  rho_jet = 2.0 
  v_cap = 4.255384324

</problem>
  
<output1>
  dt = 0.01
  file_type = vtk
  variable = prim
  id = sinkjet
</output1>

